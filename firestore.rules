rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /cart/{cartItemId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null;
      // 在庫更新は認証済みユーザーなら誰でも可能 (注文処理のため)
      // それ以外のフィールドの更新は生産者のみ
      allow update: if request.auth != null && 
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) ||
                       request.auth.uid == resource.data.producerId);
      allow delete: if request.auth != null && request.auth.uid == resource.data.producerId;
    }

    match /orders/{orderId} {
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
