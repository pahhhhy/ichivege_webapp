
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /cart/{cartItemId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == resource.data.producerId || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']));
      allow delete: if request.auth != null && request.auth.uid == resource.data.producerId;
    }

    match /orders/{orderId} {
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == '管理者';
    }

    match /chats/{chatId} {
      // Allow create if the user is one of the participants
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantUids;
      
      // Allow read/update if the user is one of the participants
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participantUids;

      match /messages/{messageId} {
        // Allow read if user is participant of the parent chat room
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids;
        // Allow create if the user is the sender and a participant
        allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids;
        // Allow updating only the 'readBy' field if user is a participant
        allow update: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      }
    }
  }
}
