
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Allow users to read and update their own profile.
      allow read, update: if request.auth != null && request.auth.uid == userId;
      // Allow anyone to create a user profile (for signup).
      allow create: if request.auth != null;
    }

    match /products/{productId} {
      // Allow anyone to read products.
      allow read: if true;
      // Only authenticated users with the '農家' (Farmer) role can create products.
      allow create: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == '農家';
      // Only the farmer who created the product can update or delete it.
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.producerId;
    }
    
    match /users/{userId}/cart/{itemId} {
      // Users can only access their own cart.
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /orders/{orderId} {
      // Users can only create orders for themselves.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // Users can only read their own orders.
      allow list: if request.auth != null && request.auth.uid == request.query.where.value;
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      // Order status can be updated by an admin (or a producer, depending on logic).
      // For now, let's prevent updates from clients.
      allow update: if false; 
    }
    
    match /posts/{postId} {
        // Any authenticated user can read posts
        allow read: if request.auth != null;
        // Only admins can create, update, or delete posts
        allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == '管理者';
    }

    match /chats/{chatId} {
        // Users can create a chat room if they are one of the participants
        allow create: if request.auth != null && request.auth.uid in request.resource.data.participantUids;
        // Users can read/update a chat room if they are one of the participants
        allow read, update: if request.auth != null && request.auth.uid in resource.data.participantUids;

        match /messages/{messageId} {
            // Users can read messages if they are a participant of the parent chat room
            allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids;
            // Users can create messages if they are a participant
            allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids;
            // Allow participants to update messages (e.g., to add to the 'readBy' array)
            allow update: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids;
        }
    }
  }
}
