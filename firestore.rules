
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == '管理者';
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);

      match /cart/{cartItemId} {
        allow read, write, delete: if isOwner(userId);
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == resource.data.producerId);
      allow delete: if request.auth != null && request.auth.uid == resource.data.producerId;
    }

    match /orders/{orderId} {
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }
  }
}
