
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // ログインユーザーは他のユーザーの情報を読めるが、書き込めるのは自分自身の情報のみ
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // ユーザーは自分自身のカート情報のみ読み書き、削除できる
      match /cart/{cartItemId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.producerId;
      // 在庫の更新は認証済みユーザーなら誰でもOK（注文処理のため）
      // それ以外のフィールドの更新は生産者のみ
      allow update: if request.auth != null && (
        (request.resource.data.keys().hasOnly(['stock']) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])) ||
        request.auth.uid == resource.data.producerId
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.producerId;
    }

    match /orders/{orderId} {
      // ユーザーは自身の注文を作成・閲覧できる
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
