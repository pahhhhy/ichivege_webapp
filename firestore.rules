rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check user role
    function isUserRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // Users can only read their own profile, but can be created by anyone during signup.
    // Users can update their own profile.
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;

      // Cart can only be accessed by the owner
      match /cart/{cartId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Products can be read by any authenticated user.
    // Only users with the '農家' role can create or update products.
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isUserRole('農家');
    }

    // Orders collection
    match /orders/{orderId} {
      // Allow users to list and read their own orders.
      allow list, read: if request.auth != null && resource.data.userId == request.auth.uid;
      // Order creation/update is handled by a secure backend flow (Firebase Admin SDK), so no direct client write access is needed.
      allow write: if false;
    }

    // Posts can be read by anyone. Only admins can create/update/delete.
    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null && isUserRole('管理者');
    }

    // Chats
    match /chats/{chatId} {
      // Participants can read/write the chat room document (e.g., update last message)
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participantUids;

      // Messages can be read by participants.
      // Users can only create messages where they are the sender.
      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      }
    }
  }
}
