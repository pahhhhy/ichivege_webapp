
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;

      // Cart subcollection
      match /cart/{cartItemId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /products/{productId} {
      allow read: if true; // Anyone can view products
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == '農家';
    }

    match /orders/{orderId} {
      // Allow user to read their own orders
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // Orders are created via a server-side flow, so no direct client creation is allowed.
      allow create: if false; 
      allow update, delete: if false; // Disallow updates and deletes from client
    }

    match /posts/{postId} {
      allow read: if true; // Anyone can read posts
      // Only users with '管理者' role can create, update, or delete posts
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == '管理者';
    }

    match /chats/{chatId} {
      // Allow read/write only if the user is a participant
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participantUids;

      match /messages/{messageId} {
         // Allow read if user is a participant in the parent chat
        allow read: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids.hasAny([request.auth.uid]);
        // Allow write if user is the sender and is a participant
        allow write: if request.auth != null && request.resource.data.senderId == request.auth.uid && get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids.hasAny([request.auth.uid]);
      }
    }
  }
}
