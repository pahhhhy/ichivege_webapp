
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Users can only read/write their own user document
      allow read, write: if request.auth.uid == userId;

      // Cart subcollection rules
      match /cart/{cartId} {
        // Users can only manage their own cart
        allow read, write, delete: if request.auth.uid == userId;
      }
    }

    match /products/{productId} {
      // Anyone can read products
      allow read: if true;
      
      // Producers can create and delete their own products
      allow create, delete: if request.auth.uid == request.resource.data.producerId;
      
      // Allow producers to update all fields, but any authenticated user to update only the stock.
      allow update: if (request.auth.uid == resource.data.producerId) ||
                       (request.auth.uid != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']));
    }

    match /orders/{orderId} {
      // Users can read and write their own orders
      allow write: if request.auth.uid == request.resource.data.userId;
      allow read: if request.auth.uid == resource.data.userId;
    }
  }
}
