rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // `users` collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(userId);

      // `cart` subcollection
      match /cart/{cartId} {
        allow read, write, delete: if isOwner(userId);
      }
    }

    // `products` collection
    match /products/{productId} {
      allow read: if true; // Everyone can read products
      allow create: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == '農家' && request.resource.data.producerId == request.auth.uid;

      // Allow anyone authenticated to update stock, but only the producer to update other fields.
      allow update: if request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
                    || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == '農家' && resource.data.producerId == request.auth.uid;
    }

    // `orders` collection
    match /orders/{orderId} {
        allow read: if isOwner(resource.data.userId);
        allow create: if isOwner(request.resource.data.userId);
    }
  }
}
