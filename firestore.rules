rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /cart/{cartItemId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null;
      
      // Allow any authenticated user to update (for stock changes during order)
      // but only the producer to delete or change other fields.
      // A more secure rule would separate stock updates into a separate write permission.
      allow update: if request.auth != null; 
      allow delete: if request.auth != null && request.auth.uid == resource.data.producerId;
    }

    match /orders/{orderId} {
        allow read, create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
  }
}
