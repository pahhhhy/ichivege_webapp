
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to products
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == '農家';
    }

    // Users can only read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can only manage their own cart
    match /users/{userId}/cart/{cartId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Orders: Users can create for themselves, and only read/update/list their own.
    match /orders/{orderId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // Allow list queries for user's own orders
      allow list: if request.auth != null && request.query.where.path == "userId" && request.query.where.op == "==" && request.query.where.value == request.auth.uid;
      // Allow read and update for user's own orders
      allow read, update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Posts: Admins can create, anyone can read
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == '管理者';
    }

    // Chats:
    match /chats/{chatId} {
      // Create: Allow if user is in the participants list of the new chat room
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantUids;
      // Read, Update: Allow if user is in the participants list of the existing chat room
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participantUids;
      
      // Messages subcollection
      match /messages/{messageId} {
        // Create: Allow if user is in the participants list of the parent chat room and senderId is their own UID
        allow create: if request.auth != null 
                      && request.auth.uid == request.resource.data.senderId 
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids;
        // Read, Update: Allow if user is in the participants list of the parent chat room
        allow read, update: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids;
      }
    }
  }
}
