
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isUserAuthenticated() {
      return request.auth != null;
    }

    function isUserProfileOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function getUserRole(userId) {
        return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isUserAdmin(userId) {
        return getUserRole(userId) == '管理者';
    }

    match /users/{userId} {
      allow read: if isUserAuthenticated();
      allow write: if isUserProfileOwner(userId);
    }

    match /users/{userId}/cart/{document=**} {
        allow read, write: if isUserProfileOwner(userId);
    }

    match /products/{productId} {
      allow read: if true;
      // Allow write only for users with '農家' or '管理者' role
      allow write: if isUserAuthenticated() && (getUserRole(request.auth.uid) == '農家' || isUserAdmin(request.auth.uid));
    }
    
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isUserAuthenticated() && isUserAdmin(request.auth.uid);
    }
    
    match /chats/{chatId} {
        // You can only create a chat room if you are one of the participants.
        allow create: if isUserAuthenticated() && request.auth.uid in request.resource.data.participantUids;
        // You can only read, update or delete a chat room if you are one of the participants.
        allow read, update, delete: if isUserAuthenticated() && request.auth.uid in resource.data.participantUids;
        
        match /messages/{messageId} {
            // You can only read or create messages if you are a participant of the parent chat room.
            allow read, create: if isUserAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids;
            // You can only update or delete your own messages.
            allow update, delete: if isUserAuthenticated() && request.auth.uid == resource.data.senderId;
        }
    }
    
    match /orders/{orderId} {
        allow read, write: if isUserAuthenticated() && resource.data.userId == request.auth.uid;
        allow create: if isUserAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
  }
}
