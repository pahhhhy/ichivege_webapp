
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザーは自分自身のプロフィールのみ読み書きできます。
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 商品は誰でも読めるが、書き込みは認証済みのユーザーのみ可能
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null;
      // You might want to add more specific update/delete rules, e.g. only the producer can edit.
      // allow update, delete: if request.auth != null && resource.data.producerId == request.auth.uid;
    }
  }
}
